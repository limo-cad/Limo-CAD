    "e2e:drawing": "node scripts/run-e2e.mjs e2e-drawing.mjs",
    "e2e:joints": "node scripts/run-e2e.mjs e2e-joints.mjs",
    "e2e:m1b": "node scripts/run-e2e.mjs e2e-m1b.mjs",
    "e2e:m1c": "node scripts/run-e2e.mjs e2e-m1c.mjs",
    "e2e:m1c2": "node scripts/run-e2e.mjs e2e-m1c2.mjs",
    "e2e:m1d": "node scripts/run-e2e.mjs e2e-m1d.mjs",
    "e2e:m1dfixes": "node scripts/run-e2e.mjs e2e-m1d-fixes.mjs",
    "e2e:input-selection": "node scripts/run-e2e.mjs e2e-input-selection.mjs",
    "e2e:constraint-hardening": "node scripts/run-e2e.mjs e2e-sketch-constraint-hardening.mjs",
    "e2e:reference-dimensions": "node scripts/run-e2e.mjs e2e-reference-dimensions.mjs",
    "e2e:grid": "node scripts/run-e2e.mjs e2e-adaptive-grid.mjs",
    "e2e:origin-chain": "node scripts/run-e2e.mjs e2e-origin-chain.mjs",
    "e2e:point-extension": "node scripts/run-e2e.mjs e2e-point-extension.mjs",
    "e2e:overlapping-profile": "node scripts/run-e2e.mjs e2e-overlapping-profile.mjs",
    "e2e:shared-profile": "node scripts/run-e2e.mjs e2e-shared-profile-extrude.mjs",
    "e2e:internal-datum-profile": "node scripts/run-e2e.mjs e2e-internal-datum-profile.mjs",
    "e2e:solid-edge-picking": "node scripts/run-e2e.mjs e2e-solid-edge-picking.mjs",
    "e2e:selection-readout": "node scripts/run-e2e.mjs e2e-selection-readout.mjs",
    "e2e:extrude-enter-profile": "node scripts/run-e2e.mjs e2e-extrude-enter-profile.mjs",
    "e2e:extrude-planar-face": "node scripts/run-e2e.mjs e2e-extrude-planar-face.mjs",
    "e2e:modeling-picker-state": "node scripts/run-e2e.mjs e2e-modeling-picker-state.mjs",
    "e2e:face-sketch-profile-picking": "node scripts/run-e2e.mjs e2e-face-sketch-profile-picking.mjs",
    "e2e:surface-point-feedback": "node scripts/run-e2e.mjs e2e-surface-point-feedback.mjs",
    "e2e:history-plane": "node scripts/run-e2e.mjs e2e-history-plane-stability.mjs",
    "e2e:timeline": "node scripts/run-e2e.mjs e2e-timeline-drag-delete.mjs",
    "e2e:hole": "node scripts/run-e2e.mjs e2e-hole-multi-point.mjs",
    "e2e:hole-thread": "node scripts/run-e2e.mjs e2e-hole-thread.mjs",
    "e2e:external-thread": "node scripts/run-e2e.mjs e2e-external-thread.mjs",
    "e2e:slot": "node scripts/run-e2e.mjs e2e-slot.mjs",
    "e2e:spline": "node scripts/run-e2e.mjs e2e-spline.mjs",
    "e2e:m2": "node scripts/run-e2e.mjs e2e-m2.mjs",
    "e2e:revolve": "node scripts/run-e2e.mjs e2e-revolve.mjs",
    "e2e:advanced-solids": "node scripts/run-e2e.mjs e2e-advanced-solids.mjs",
    "e2e:project-lifecycle": "node scripts/run-e2e.mjs e2e-project-lifecycle.mjs",
    "e2e:theme": "node scripts/run-e2e.mjs e2e-theme.mjs",
    "e2e:six-dof": "node scripts/run-e2e.mjs e2e-six-dof-mouse.mjs",
    "e2e:bevy-kernel": "node scripts/run-e2e.mjs e2e-bevy-interaction-kernel.mjs",
    "e2e:files": "node scripts/run-e2e.mjs e2e-m2.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "earcut": "^3.0.2",
    "fflate": "0.8.3",
    "lucide-react": "^0.474.0",
    "opencascade.js": "2.0.0-beta.b5ff984",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }

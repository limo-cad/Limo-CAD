  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "dev:bevy-ui:capture": "node scripts/capture-bevy-ui.mjs",
    "build": "tsc && vite build",
    "build:desktop": "tsc && vite build --mode desktop && node scripts/verify-desktop-assets.mjs",
    "preview": "vite preview",
    "stage:occt": "node scripts/stage-occt-macos.mjs",
    "bundle:macos": "node scripts/bundle-macos.mjs",
    "bundle:linux": "node scripts/bundle-linux.mjs",
    "bundle:windows:portable": "pwsh -NoProfile -File scripts/bundle-windows-portable.ps1",
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../src/engine-wasm/pkg --out-name nbcad_wasm",
    "smoke:wasm": "node scripts/smoke-wasm.mjs",
    "test:frontend": "npm run test:constraint-glyphs && npm run test:revolve-axis && npm run test:modeling-picker && npm run test:screen-picker && npm run test:viewport-theme && npm run test:project-archive && npm run test:profile-picker && npm run test:presentation && npm run test:drawing-instances && npm run test:export-flow",

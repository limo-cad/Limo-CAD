    "test:export-flow": "tsx src/files/exportFlow.test.ts && tsx src/engine/projectLoad.test.ts",
    "test:presentation": "tsx src/operationPlayback.test.ts && tsx src/viewControl.test.ts",
    "test:constraint-glyphs": "tsx src/sketch/constraintGlyphAnchor.test.ts",
    "test:revolve-axis": "tsx src/lib/revolveAxis.test.ts",
    "test:modeling-picker": "tsx src/modeling/viewportPicker.test.ts",
    "test:screen-picker": "tsx src/modeling/screenSpaceEntityPicker.test.ts",
    "test:viewport-theme": "tsx src/theme/viewportInteractionTheme.test.ts",
    "test:project-archive": "tsx src/files/nbcad.test.ts && node scripts/test-project-archive.mjs",
    "test:profile-picker": "tsx src/modeling/profileRegionPicker.test.ts",
    "check:knowledge": "node scripts/check-knowledge.mjs",
    "audit:icons": "node scripts/audit-icons.mjs",
    "e2e": "node scripts/run-e2e.mjs",

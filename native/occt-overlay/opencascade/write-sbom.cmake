# Keep OCCT build evidence inside the vcpkg binary cache entry. The port verifies
# the upstream SHA512 and original math sources before compiling this variant.
set(sbom "{\n  \"schemaVersion\": 1,\n  \"version\": \"${VERSION}\",\n  \"triplet\": \"${TARGET_TRIPLET}\",\n  \"sourceSha512\": \"65935a2f46021e2b9a7dd2a218515c06925454855a8cc952fcbd1cccbfd5c8d605ed8f1d930d2aec87ef172ded551d0a237fad128319fb9cbcabdc755aa0aa67\",\n  \"patches\": {\n")
set(separator "")
foreach(patch fix-install-prefix-path.patch drop-bin-letter-d.patch dependencies.patch
    install-include-dir.patch remove-vcpkg-enabling.patch math_DoubleTab.cxx math_DoubleTab.lxx)
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${patch}" digest)
    string(APPEND sbom "${separator}    \"${patch}\": \"${digest}\"")
    set(separator ",\n")
endforeach()
string(APPEND sbom "\n  },\n  \"files\": {\n")
set(separator "")
file(GLOB libraries RELATIVE "${CURRENT_PACKAGES_DIR}" "${CURRENT_PACKAGES_DIR}/bin/TK*.dll")
list(SORT libraries)
foreach(library IN LISTS libraries)
    file(SHA256 "${CURRENT_PACKAGES_DIR}/${library}" digest)
    string(APPEND sbom "${separator}    \"${library}\": \"${digest}\"")
    set(separator ",\n")
endforeach()
string(APPEND sbom "\n  }\n}\n")
file(WRITE "${CURRENT_PACKAGES_DIR}/share/opencascade/limo-occt-build.json" "${sbom}")

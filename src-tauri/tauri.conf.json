{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noBS CAD",
  "version": "0.2.2",
  "identifier": "org.nbcad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Limo CAD",
        "width": 560,
        "height": 380,
        "minWidth": 560,
        "minHeight": 380,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "maximizable": false,
        "acceptFirstMouse": true,
        "backgroundColor": "#23262b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["nbcad"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

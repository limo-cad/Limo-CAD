diff --git a/crates/occt/src/drawing_presentation/cloud.rs b/crates/occt/src/drawing_presentation/cloud.rs
index 673c07a8..1e726338 100644
--- a/crates/occt/src/drawing_presentation/cloud.rs
+++ b/crates/occt/src/drawing_presentation/cloud.rs
@@ -62,6 +62,16 @@ impl<'a> Cloud<'a> {
     pub fn work(&self) -> u64 {
         self.count * MAX_ARC_POINTS
     }
+    /// First baseline of the complete formatted caption. The final row keeps
+    /// the existing single-row position above the cloud; preceding rows grow
+    /// upward instead of entering its scallops. Saved vertices never move.
+    pub fn caption_baseline(&self, text: &str) -> P {
+        let preceding_rows = text.lines().count().saturating_sub(1);
+        [
+            self.label[0],
+            self.label[1] - preceding_rows as f64 * TEXT_HEIGHT_MM * 1.25,
+        ]
+    }
     pub fn arcs(&self) -> impl Iterator<Item = Scallop> + '_ {
         self.points.iter().enumerate().flat_map(|(index, &start)| {
             let end = self.points[(index + 1) % self.points.len()];
@@ -157,4 +167,26 @@ mod tests {
         assert!(Cloud::new(&[[f64::MAX, 0.], [-f64::MAX, 1.], [0., 2.]]).is_err());
         assert!(Cloud::new(&vec![[0., 0.]; 4097]).is_err());
     }
+
+    #[test]
+    fn multiline_caption_grows_upward_and_retains_single_row_clearance() {
+        let points = [[40., 55.], [135., 55.], [135., 115.], [40., 115.]];
+        let cloud = Cloud::new(&points).unwrap();
+        let top_ink = cloud
+            .arcs()
+            .flat_map(Scallop::points)
+            .map(|p| p[1] - STROKE_MM * 0.5)
+            .fold(f64::INFINITY, f64::min);
+        for text in ["REV B", "REV B\nCafé 零件", "REV B\r\nCafé\r\nC\r\n"] {
+            let first = cloud.caption_baseline(text);
+            let last = first[1] + (text.lines().count() - 1) as f64 * 4.;
+            assert_eq!(last, 53.);
+            assert!(last < top_ink, "caption baseline must stay above scallop ink");
+            assert_eq!(first[0], 40.);
+        }
+        assert_eq!(cloud.caption_baseline("REV B"), cloud.label);
+        assert_eq!(cloud.caption_baseline("REV B\nCafé 零件"), [40., 49.]);
+        assert_eq!(cloud.caption_baseline("REV B\nC\nD"), [40., 45.]);
+        assert_eq!(points, [[40., 55.], [135., 55.], [135., 115.], [40., 115.]]);
+    }
 }

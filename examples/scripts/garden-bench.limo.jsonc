      }
    },
    {
      "id": "front_leg_left_add_rectangle_locked",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {"x": 0, "y": 0},
          "corner_hint": {"x": 65, "y": 65},
          "width_mm": 65,
          "height_mm": 65,
          "ctrl_held": true
        }
      }
    },
    {"id": "bench_present_front_leg_left_begin_profile_view", "view": "top", "fit": true, "duration_ms": 550, "target": "active_sketch"},
    {"id": "bench_present_front_leg_left_begin_profile_read", "note": "Left front leg: 65 x 65 mm profile, viewed square-on before the feature.", "duration_ms": 1000},

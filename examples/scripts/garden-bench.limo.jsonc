        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Front leg and arm post / stock from A-B-C",
          "profile_indices": [0],
          "operation": "new_body",
          "extent": {"type": "distance", "distance": 630},
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": []
        }
      }
    },
    {
      "call": {
        "arguments": {
          "feature_id": {
            "$select": {
              "from": {
                "$ref": "front_leg_left_extrude"
              },
              "path": "/document/features",
              "pointer": "/id",
              "take": "last"

{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Crown garden bench — referenced joinery",
  "verification": "garden-bench",
  "steps": [
    {
      "chapter": "Blank document",
      "note": "A 1200 mm timber seat at 450 mm height, with repeated crowned pickets. Build, edit and restore the assembly; fabrication qualification is still pending.",
      "duration_ms": 2200
    },
    {
      "id": "blank_document",
      "call": {"group": "document/files", "operation": "cad_project_model", "arguments": {}},
      "expect": {"/document/history/features": [], "/sketches": []}
    },
    {"id": "blank_active_sketch", "call": {"group": "sketch/draw", "operation": "sketch_active", "arguments": {}}},
    {"assert": {"$ref": "blank_active_sketch"}, "equals": null},
    {"view": "isometric", "fit": true},
    {
      "id": "cad_set_document_name",
      "call": {
        "group": "document/files",
        "operation": "cad_set_document_name",
        "arguments": {"name": "Crown garden bench — referenced joinery"}
      }
    },
    {
      "chapter": "Frame",
      "note": "Start at the machining origin: a marked face, adjacent edge and square end locate each timber member. Dimensions remain editable.",
      "duration_ms": 700
    },
    {"view": "isometric", "fit": true},
    {"id": "bench_present_front_leg_left_visibility", "call": {"group": "document/appearance", "operation": "project_visibility", "arguments": {}}},
    {"id": "bench_present_front_leg_left_begin_profile_isolate", "call": {"group": "document/appearance", "operation": "project_set_visibility", "arguments": {"hidden_body_ids": [], "hidden_sketch_names": {"$ref": "bench_present_front_leg_left_visibility", "pointer": "/hidden_sketch_names"}, "hidden_datum_plane_ids": {"$ref": "bench_present_front_leg_left_visibility", "pointer": "/hidden_datum_plane_ids"}}}},
    {
      "id": "front_leg_left_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",

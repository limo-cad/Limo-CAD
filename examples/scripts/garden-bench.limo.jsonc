    {"id": "bench_present_front_leg_left_begin_result_isolate", "call": {"group": "document/appearance", "operation": "project_set_visibility", "arguments": {"hidden_body_ids": [], "hidden_sketch_names": {"$ref": "bench_hide_finished_after_front_leg_left_extrude", "pointer": "/hidden_sketch_names"}, "hidden_datum_plane_ids": {"$ref": "bench_hide_finished_after_front_leg_left_extrude", "pointer": "/hidden_datum_plane_ids"}}}},

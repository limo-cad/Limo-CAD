          "entity": {
            "$select": {
              "from": {"$ref": "front_leg_left_add_rectangle_locked", "pointer": "/sketch"},
              "path": "/entities",
              "take": "one",
              "where": {"/kind": "point", "/position/x": 0, "/position/y": 0},
              "pointer": "/id"
            }
          }
        }
      }
    },
    {"id": "front_leg_left_finish", "call": {"group": "sketch/draw", "operation": "sketch_finish", "arguments": {}}},
    {
      "id": "front_leg_left_extrude",

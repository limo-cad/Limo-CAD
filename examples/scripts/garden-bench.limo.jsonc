        },
        "group": "document/history",
        "operation": "solid_rename_feature"
      },
      "id": "front_leg_left_extrude_feature_name"
    },
    {"id": "bench_hide_finished_after_front_leg_left_extrude", "call": {"group": "solid/reference", "operation": "construction_set_visibility", "arguments": {"visible": false}}},

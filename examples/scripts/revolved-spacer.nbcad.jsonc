// Native recipe migrated from the small part-design fixtures. Dimensions are millimetres.
// No captured entity IDs or model snapshots are used to construct the design.
{
  "$schema": "./nbcad-script.schema.json",
  "version": 1,
  "name": "Revolved annular spacer",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "Locate the radial section",
      "note": "A 5 mm wide by 12 mm long section begins at radius 5 mm from the Y axis. The two radial positions set a 10 mm bore and 20 mm outside diameter.",
      "duration_ms": 1000
    },
    {
      "id": "spacer_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Spacer / bore radius and length section",
          "plane": {
            "type": "origin_plane",
            "plane": "xy"
          }
        }
      }
    },
    {
      "id": "spacer_rectangle",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {
            "x": 5,
            "y": 0
          },
          "corner_hint": {
            "x": 10,
            "y": 12
          },
          "width_mm": 5,
          "height_mm": 12,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "spacer_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "spacer_rectangle",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point",
                "/position/x": 5,
                "/position/y": 0
              },
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "chapter": "Revolve the annulus",
      "note": "Rotate the closed radial section a full turn around the sketch Y axis. This creates one native solid with an open bore, not an imported tube.",
      "duration_ms": 1000
    },
    {
      "view": "current",
      "fit": true,
      "target": "active_sketch",
      "duration_ms": 250
    },
    {
      "id": "spacer_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "spacer_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_revolve",
        "arguments": {
          "sketch_name": "Spacer / bore radius and length section",
          "profile_indices": [
            0
          ],
          "axis_origin": {
            "x": 0,
            "y": 0
          },
          "axis_direction": {
            "x": 0,
            "y": 1
          },
          "axis_line_entity_id": null,
          "angle_deg": 360,
          "flip": false,
          "operation": "new_body",
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "spacer_feature": {
          "$select": {
            "from": {
              "$ref": "spacer_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "spacer_body": {
          "$select": {
            "from": {
              "$ref": "spacer_build"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "spacer_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "body_id": {
        "$ref": "spacer_body",
        "pointer": "/id"
      },
      "duration_ms": 350
    },
    {
      "let": {
        "spacer_finished_body": {
          "$ref": "spacer_body"
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "duration_ms": 400
    },
    {
      "chapter": "Inspect the editable result",
      "note": "Review the retained sketch and feature history. Maximum speed, step-through teaching and paced presentation execute this same construction source.",
      "duration_ms": 1000
    }
  ],
  "checks": [
    {
      "id": "final_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      },
      "expect": {
        "/errors": []
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "final_scene",
          "pointer": "/bodies"
        }
      },
      "equals": 1
    },
    {
      "id": "final_sketches",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finished",
        "arguments": {}
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "final_sketches"
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$ref": "final_sketches",
        "pointer": "/0/dof/value"
      },
      "equals": 0
    },
    {
      "id": "final_solution",
      "call": {
        "group": "assembly/joints",
        "operation": "assembly_solution",
        "arguments": {}
      },
      "expect": {
        "/solved": true,
        "/diagnostics": []
      }
    },
    {
      "id": "final_model",
      "call": {
        "group": "document/files",
        "operation": "cad_project_model",
        "arguments": {}
      }
    }
  ],
  "exports": {
    "final_model": {
      "$ref": "final_model"
    },
    "final_scene": {
      "$ref": "final_scene"
    },
    "final_sketches": {
      "$ref": "final_sketches"
    },
    "final_solution": {
      "$ref": "final_solution"
    }
  }
}

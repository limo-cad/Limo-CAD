            "y": 35.0
          },
          "ctrl_held": true,
          "height_mm": 70.0,
          "mode": "two_point",
          "width_mm": 150.0
        },
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked"
      },
      "id": "Frame base / 150 by 70_profile"

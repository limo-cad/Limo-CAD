  "name": "D-shaped printed screw vise",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "A small functional vise",
      "duration_ms": 1800,
      "note": "Five printable parts: frame, guided jaw, round threaded wear nut, one-piece D screw and sliding keeper. PETG is the provisional indoor material. Geometry checks do not establish a physical clamping-force rating."
    },
    {
      "call": {
        "arguments": {
          "name": "D-screw vise / PETG design candidate"
        },
        "group": "document/files",
        "operation": "cad_set_document_name"
      },
      "id": "name"
    },
    {
      "chapter": "Frame: base and load path",
      "duration_ms": 1800,
      "note": "The 150 × 70 × 8 base connects a broad fixed jaw to a captive nut housing. Four rectangular slots allow fixture screws to be positioned without making the example dependent on a particular bench."
    },
    {
      "call": {
        "arguments": {
          "name": "Frame base / 150 by 70",
          "plane": {
            "plane": "xy",
            "type": "origin_plane"
          }
        },
        "group": "sketch/draw",
        "operation": "sketch_begin"
      },
      "id": "Frame base / 150 by 70_begin"
    },
    {
      "call": {
        "arguments": {
          "enabled": false
        },
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap"
      },
      "id": "Frame base / 150 by 70_snap"
    },
    {
      "call": {
        "arguments": {
          "anchor": {
            "x": 0.0,
            "y": -35.0
          },
          "corner_hint": {
            "x": 150.0,
            "y": 35.0
          },
          "ctrl_held": true,
          "height_mm": 70.0,
          "mode": "two_point",
          "width_mm": 150.0
        },
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked"
      },
      "id": "Frame base / 150 by 70_profile"
    },
    {
      "call": {
        "arguments": {
          "entity": {
            "$select": {
              "from": {
                "$ref": "Frame base / 150 by 70_profile",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "pointer": "/id",
              "take": "one",
              "where": {
                "/kind": "point",
                "/position/x": 0.0,
                "/position/y": -35.0
              }
            }
          },
          "type": "fix"
        },
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint"
      },
      "id": "Frame base / 150 by 70_locate"
    },
    {
      "duration_ms": 180,
      "fit": true,
      "target": "active_sketch",
      "view": "current"
    },
    {
      "call": {
        "arguments": {},
        "group": "sketch/draw",
        "operation": "sketch_finish"
      },
      "id": "Frame base / 150 by 70_finish"
    },
    {
      "call": {
        "arguments": {
          "extent": {
            "distance": 8.0,
            "type": "distance"
          },
          "flip": false,
          "operation": "new_body",
          "profile_indices": [
            0
          ],
          "sketch_name": "Frame base / 150 by 70",
          "taper_angle_deg": 0,
          "target_body_ids": []
        },
        "group": "solid/build",
        "operation": "solid_extrude"
      },
      "id": "Frame base / 150 by 70_build"
    },
    {
      "let": {
        "frame_feature": {
          "$select": {
            "from": {
              "$ref": "Frame base / 150 by 70_build",
              "pointer": ""
            },
            "path": "/document/features",
            "pointer": "/id",
            "take": "last"
          }
        }
      }
    },
    {
      "let": {
        "frame_body_id": {
          "$select": {
            "from": {
              "$ref": "Frame base / 150 by 70_build",
              "pointer": ""
            },
            "path": "/scene/bodies",
            "pointer": "/id",
            "take": "one",
            "where": {
              "/feature_id": {
                "$ref": "frame_feature",
                "pointer": ""

        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / prepared 32 by 44 section",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 40
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": []
        }

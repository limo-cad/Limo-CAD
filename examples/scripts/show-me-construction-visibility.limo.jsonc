      }
    },
    {
      "assert": {
        "$ref": "restored",
        "pointer": "/hidden_sketch_names"
      },
      "equals": []
    },
    {
      "assert": {
        "$ref": "restored",
        "pointer": "/hidden_datum_plane_ids"
      },
      "equals": []
    },
    {
      "assert": {
        "$ref": "hidden",
        "pointer": "/hidden_body_ids"
      },
      "equals": {
        "$ref": "visible",
        "pointer": "/hidden_body_ids"
      }
    },
    {
      "assert": {
        "$ref": "sketch_only",
        "pointer": "/hidden_body_ids"
      },
      "equals": {
        "$ref": "visible",
        "pointer": "/hidden_body_ids"
      }
    },
    {
      "assert": {
        "$ref": "restored",
        "pointer": "/hidden_body_ids"
      },
      "equals": {
        "$ref": "visible",
        "pointer": "/hidden_body_ids"
      }
    }
  ],
  "exports": {
    "lessons": {
      "construction_visibility": [

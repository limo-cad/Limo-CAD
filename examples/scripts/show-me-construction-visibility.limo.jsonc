      "equals": [
        "Bracket / prepared 32 by 44 section"
      ]
    },
    {
      "assert": {
        "$ref": "hidden",
        "pointer": "/hidden_datum_plane_ids"
      },
      "equals": [
        {
          "$ref": "datums",
          "pointer": "/0/datum_id"

        "$count": {
          "$ref": "datums"
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$ref": "datums",
        "pointer": "/0/source/distance"
      },
      "equals": -20
    },
    {
      "assert": {
        "$ref": "datums",
        "pointer": "/0/basis/origin/1"
      },
      "equals": 20
    },
    {
      "id": "visible",
      "call": {
        "group": "document/appearance",
        "operation": "project_visibility",
        "arguments": {}
      }
    },
    {
      "id": "hidden",
      "call": {
        "group": "solid/reference",
        "operation": "construction_set_visibility",
        "arguments": {
          "visible": false
        }
      }
    },
    {
      "id": "sketch_only",
      "call": {
        "group": "solid/reference",
        "operation": "construction_set_visibility",
        "arguments": {
          "visible": true,
          "sketch_names": [
            "Bracket / prepared 32 by 44 section"
          ]
        }
      }
    },
    {
      "id": "restored",
      "call": {
        "group": "solid/reference",
        "operation": "construction_set_visibility",
        "arguments": {
          "visible": true
        }
      }
    }
  ],
  "checks": [

              },
              "take": "one",
              "pointer": "/start_id"
            }
          }
        }
      }
    },
    {
      "id": "bracket_square",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraints",
        "arguments": {
          "constraints": [
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_0"
              }
            },
            {
              "type": "vertical",
              "entity": {

      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      },
      "expect": {
        "/errors": []
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "source_scene",
          "pointer": "/bodies"
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$ref": "bracket_dimension_5",

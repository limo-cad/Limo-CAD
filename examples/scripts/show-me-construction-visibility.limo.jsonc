    {
      "id": "bracket_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "bracket_line_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/id": {
                  "$ref": "bracket_edge_0"

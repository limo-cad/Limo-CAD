            "x": 0.0,
            "y": 0.0
          }
        },
        "group": "sketch/draw",
        "operation": "sketch_add_point"
      },
      "id": "centre_point_4"
    },
    {
      "call": {
        "arguments": {
          "entity": {
            "$select": {
              "from": {
                "$ref": "centre_point_4",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "pointer": "/id",
              "take": "last",
              "where": {
                "/kind": "point"
              }
            }
          },
          "type": "fix"
        },
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint"
      },
      "id": "locate_circle_5"
    },
    {
      "call": {
        "arguments": {
          "enabled": true
        },
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap"
      },
      "id": "acquire_center_7"
    },
    {
      "call": {
        "arguments": {
          "anchor": {
            "x": 0.0,
            "y": 0.0
          },
          "ctrl_held": false,
          "diameter_text": "198",
          "edge_hint": {
            "x": 99.0,
            "y": 0.0
          },
          "mode": "center_diameter"
        },
        "group": "sketch/draw",
        "operation": "sketch_add_circle_locked"

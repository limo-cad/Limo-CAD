                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "occurrence_id": {
              "$ref": "cap_occurrence",
              "pointer": "/id"
            }
          },
          "leader_angle_deg": 35.0,
          "mode": "diameter",
          "offset": 12.0,
          "precision": 2,
          "sheet_id": {
            "$ref": "assembly_sheet_id"
          },
          "view_id": {
            "$ref": "assembly_top_view_id"
          }
        },

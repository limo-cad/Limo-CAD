        "arguments": {
          "hidden_body_ids": {
            "$select": {
              "from": {
                "bodies": []
              },
              "path": "/bodies",
              "pointer": "/id",
              "take": "all",
              "where": {}
            }
          },
          "hidden_datum_plane_ids": {
            "$ref": "stage_before_sketch_visibility",
            "pointer": "/hidden_datum_plane_ids"

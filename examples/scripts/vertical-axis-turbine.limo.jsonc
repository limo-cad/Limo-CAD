  "name": "Vertical-axis turbine / two-stage Savonius",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "The experiment",
      "duration_ms": 3000,
      "note": "Two 198 mm rotor discs, 200 mm combined bucket height, an 8 x 300 mm shaft and a 4:1 generator drive. The printed design and representative hardware still need physical fit and output testing."
    },
    {
      "chapter": "Repeated rotor stage",
      "duration_ms": 3000,
      "note": "Concentric driving diameters define a bottom disc, shaft hub and two semicircular bucket walls. The clamp hub ends at 18 mm so only the 8 mm shaft divides the overlap above it. One stage definition appears twice, staggered by 90 degrees. Print each stage upright and the final cap separately."
    },
    {
      "call": {
        "arguments": {},
        "group": "document/appearance",
        "operation": "project_visibility"
      },
      "id": "stage_before_sketch_visibility"
    },
    {

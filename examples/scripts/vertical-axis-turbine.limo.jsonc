              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/closed",
                "take": "first",
                "where": {
                  "/body_id": {
                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "edge_id": {
              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/edge_id",
                "take": "first",
                "where": {
                  "/body_id": {
                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "edge_key": {
              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/edge_key",
                "take": "first",
                "where": {
                  "/body_id": {
                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "fallback_center": {
              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/center_model",
                "take": "first",
                "where": {
                  "/body_id": {
                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "fallback_normal": {
              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/normal_model",
                "take": "first",
                "where": {
                  "/body_id": {
                    "$ref": "cap_body",
                    "pointer": "/id"
                  },
                  "/occurrence_id": {
                    "$ref": "cap_occurrence",
                    "pointer": "/id"
                  },
                  "/radius": 99.0
                }
              }
            },
            "fallback_radius": {
              "$select": {
                "from": {
                  "$ref": "assembly_top_projection"
                },
                "path": "/circles",
                "pointer": "/radius",
                "take": "first",
                "where": {

          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_line_context_fixed",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": {
            "$select": {
              "from": {
                "$ref": "sketch_line_context_4",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point"
              },
              "take": "all",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {

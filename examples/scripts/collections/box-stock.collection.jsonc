

{
  "$schema": "../limo-cad-script.schema.json",
  "name": "Box stock",
  "steps": [
    {
      "chapter": "Stock",
      "note": "A 20 × 20 mm square located at the origin, extruded 10 mm.",
      "duration_ms": 800
    },
    {
      "id": "box_sketch",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Box stock",
          "plane": { "type": "origin_plane", "plane": "xy" }
        }
      }
    },
    {
      "id": "box_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle",
        "arguments": {
          "mode": "two_point",
          "p1": { "x": 0, "y": 0 },
          "p2": { "x": 20, "y": 20 },
          "ctrl_held": false
        }
      }
    },
    {
      "id": "box_finish_sketch",
      "call": { "group": "sketch/draw", "operation": "sketch_finish", "arguments": {} }
    },
    {
      "id": "box_extrude",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Box stock",
          "profile_indices": [0],
          "operation": "new_body",
          "extent": { "type": "distance", "distance": 10 },
          "taper_angle_deg": 0,
          "flip": false,
          "target_body_ids": []
        }
      }
    }
  ]
}

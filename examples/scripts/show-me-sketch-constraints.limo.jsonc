          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_coincident_context_fixed",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": {
            "$select": {
              "from": {
                "$ref": "sketch_coincident_context_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point"
              },
              "take": "all",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "coincident_point",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_point",
        "arguments": {
          "position": {
            "x": 18,
            "y": 22
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "coincident_carrier",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 12,
            "y": 20
          },
          "to_raw": {
            "x": 28,
            "y": 20
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "coincident_result",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "coincident",
          "a": {
            "$ref": "coincident_point",
            "pointer": "/entities/0"
          },
          "b": {
            "$ref": "coincident_carrier",
            "pointer": "/entity_id"
          }
        }
      }
    },

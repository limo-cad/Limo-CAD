          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_mirror_context_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_mirror_context_fixed",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": {
            "$select": {
              "from": {
                "$ref": "sketch_mirror_context_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point"
              },
              "take": "all",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "mirror_source",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_circle",
        "arguments": {
          "mode": "center_diameter",
          "p1": {
            "x": 14,
            "y": 20
          },
          "p2": {
            "x": 16,
            "y": 20
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "mirror_axis",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 20,
            "y": 10
          },
          "to_raw": {
            "x": 20,
            "y": 36
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "mirror_result",
      "call": {
        "group": "sketch/repeat",
        "operation": "sketch_mirror",
        "arguments": {
          "entity_ids": [
            {
              "$select": {
                "from": {
                  "$ref": "mirror_source",
                  "pointer": "/sketch"
                },
                "path": "/entities",
                "where": {
                  "/kind": "circle"
                },
                "take": "last",
                "pointer": "/id"
              }
            }
          ],
          "axis_line": {
            "$ref": "mirror_axis",
            "pointer": "/entity_id"
          }
        }
      }
    },
    {
      "id": "sketch_mirror_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {

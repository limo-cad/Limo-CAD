    {
      "id": "sketch_circular_pattern_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    }
  ],
  "checks": [
    {
      "assert": {
        "$count": {
          "$select": {
            "from": {
              "$ref": "dimension_result",
              "pointer": "/sketch"
            },
            "path": "/dimensions",
            "where": {
              "/kind": "distance",
              "/value": 16
            },
            "take": "all"
          }
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$select": {
          "from": {
            "$ref": "dimension_result",
            "pointer": "/sketch"
          },
          "path": "/entities",
          "where": {
            "/id": {
              "$ref": "dimension_source",
              "pointer": "/entity_id"
            }
          },
          "take": "one",

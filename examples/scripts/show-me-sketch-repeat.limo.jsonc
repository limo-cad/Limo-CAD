{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Bracket sketch guides: dimension, mirror and repeat mounting details",
  "starting_state": "empty",
  "steps": [
    {
      "id": "empty_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "chapter": "sketch_dimension",
      "note": "Independent bracket layout study on the XZ plane; all coordinates are sketch millimeters. The six-edge 32 x 44 mm L with 8 mm walls is shared context. Extra curves are layout examples, not a fabrication-ready profile.",
      "duration_ms": 0
    },
    {
      "id": "sketch_dimension_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / dimension",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "id": "sketch_dimension_snap",
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "sketch_dimension_context_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_2",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_3",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_4",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_dimension_context_fixed",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": {
            "$select": {
              "from": {
                "$ref": "sketch_dimension_context_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point"
              },
              "take": "all",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "dimension_source",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 12,
            "y": 16
          },
          "to_raw": {
            "x": 22,
            "y": 16
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "dimension_direction",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "horizontal",
          "entity": {
            "$ref": "dimension_source",
            "pointer": "/entity_id"
          }
        }
      }
    },
    {
      "id": "dimension_anchor",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": [
            {
              "$ref": "dimension_source",
              "pointer": "/start_point_id"
            }
          ]
        }
      }
    },
    {
      "id": "dimension_result",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "dimension_source",
              "pointer": "/entity_id"
            }
          ],
          "text_pos": {
            "x": 20,
            "y": 12
          },
          "value_text": "16"
        }
      }
    },
    {
      "id": "sketch_dimension_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "chapter": "sketch_mirror",
      "note": "Independent bracket layout study on the XZ plane; all coordinates are sketch millimeters. The six-edge 32 x 44 mm L with 8 mm walls is shared context. Extra curves are layout examples, not a fabrication-ready profile.",

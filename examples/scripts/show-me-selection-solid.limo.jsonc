        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_4": {
          "$select": {
            "from": {
              "$ref": "bracket_line_4",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_5": {
          "$select": {
            "from": {
              "$ref": "bracket_line_5",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "bracket_line_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/id": {
                  "$ref": "bracket_edge_0"
                }
              },
              "take": "one",
              "pointer": "/start_id"
            }
          }
        }
      }
    },
    {
      "id": "bracket_square",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraints",
        "arguments": {
          "constraints": [
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_0"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_1"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_2"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_3"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_4"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_5"
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "bracket_dimension_0",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_0"
            }
          ],
          "text_pos": {
            "x": 20,
            "y": -6
          },
          "value_text": "32"
        }
      }
    },
    {
      "id": "bracket_dimension_1",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_1"
            }
          ],
          "text_pos": {
            "x": 47,
            "y": 2.5
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_4",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_4"
            }
          ],
          "text_pos": {
            "x": 2.5,
            "y": 37
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_5",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_5"
            }
          ],
          "text_pos": {
            "x": -7,
            "y": 15
          },
          "value_text": "44"
        }
      }
    },
    {
      "id": "bracket_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "bracket_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / prepared 32 by 44 section",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 40
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": []
        }
      },
      "expect": {
        "/scene/errors": []
      }
    },
    {
      "let": {
        "bracket_feature": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "bracket_body": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "bracket_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "source_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      },
      "expect": {
        "/errors": []
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "source_scene",
          "pointer": "/bodies"
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$ref": "bracket_dimension_5",
        "pointer": "/sketch/dof/value"
      },
      "equals": 0
    },
    {
      "assert": {
        "$ref": "source_scene",
        "pointer": "/bodies"
      },
      "equals": {
        "$ref": "bracket_build",
        "pointer": "/scene/bodies"
      }
    },
    {
      "let": {
        "inner_face": {
          "$select": {
            "from": {
              "$ref": "bracket_body"
            },
            "path": "/faces",
            "where": {
              "/plane/normal/0": 1,
              "/plane/origin/0": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "let": {
        "top_edge": {
          "$select": {
            "from": {
              "$ref": "bracket_body"
            },
            "path": "/edges",
            "where": {
              "$every": {
                "path": "/points",
                "where": {
                  "/x": 8,
                  "/z": 44
                }
              }
            },
            "take": "one"
          }
        }
      }
    }
  ],
  "checks": [
    {
      "id": "end_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      },
      "expect": {
        "/errors": []
      }
    },
    {
      "assert": {
        "$ref": "end_scene",
        "pointer": "/bodies"
      },
      "equals": {
        "$ref": "source_scene",
        "pointer": "/bodies"
      }
    }
  ],
  "exports": {
    "lessons": {
      "selection_solid": [
        {
          "caption": "selection_solid.inputs",
          "scene": {
            "$ref": "source_scene"
          },
          "cue": "body",
          "duration_ms": 1600,
          "finish": "satin_aluminum",
          "inspection": {
            "selection": {}
          }
        },
        {
          "caption": "selection_solid.face",
          "scene": {
            "$ref": "source_scene"
          },
          "cue": "body",
          "duration_ms": 1600,
          "finish": "satin_aluminum",
          "inspection": {
            "selection": {
              "face_ids": [
                {
                  "$ref": "inner_face",
                  "pointer": "/id"
                }
              ]
            }
          }
        },
        {
          "caption": "selection_solid.edge",
          "scene": {
            "$ref": "source_scene"
          },
          "cue": "edges",
          "duration_ms": 1600,
          "finish": "satin_aluminum",
          "inspection": {
            "selection": {}
          },
          "edges": [
            {
              "$ref": "top_edge",
              "pointer": "/id"
            }
          ]
        },
        {
          "caption": "selection_solid.clear",
          "scene": {
            "$ref": "source_scene"
          },
          "cue": "body",
          "duration_ms": 1600,
          "finish": "satin_aluminum",
          "inspection": {
            "selection": {}
          }
        }
      ]
    },
    "preview_frames": [
      {
        "caption": "selection_solid.inputs",
        "scene": {
          "$ref": "source_scene"
        },
        "cue": "body",
        "duration_ms": 1600,
        "finish": "satin_aluminum",
        "inspection": {
          "selection": {}
        }
      },
      {
        "caption": "selection_solid.face",
        "scene": {
          "$ref": "source_scene"
        },
        "cue": "body",
        "duration_ms": 1600,
        "finish": "satin_aluminum",
        "inspection": {
          "selection": {
            "face_ids": [
              {
                "$ref": "inner_face",
                "pointer": "/id"
              }
            ]
          }
        }
      },
      {
        "caption": "selection_solid.edge",
        "scene": {
          "$ref": "source_scene"
        },
        "cue": "edges",
        "duration_ms": 1600,
        "finish": "satin_aluminum",
        "inspection": {
          "selection": {}
        },
        "edges": [
          {
            "$ref": "top_edge",
            "pointer": "/id"
          }
        ]
      },
      {
        "caption": "selection_solid.clear",
        "scene": {
          "$ref": "source_scene"
        },
        "cue": "body",
        "duration_ms": 1600,
        "finish": "satin_aluminum",
        "inspection": {
          "selection": {}
        }
      }
    ],
    "selection_targets": {
      "body": {
        "$ref": "bracket_body",
        "pointer": "/id"
      },
      "face": {
        "$ref": "inner_face",
        "pointer": "/id"
      },
      "edge": {
        "$ref": "top_edge",
        "pointer": "/id"
      }
    }
  }
}

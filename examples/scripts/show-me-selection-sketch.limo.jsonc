{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Prepared bracket: selection sketch",
  "starting_state": "empty",
  "steps": [
    {
      "note": "Prepared prerequisite: the 32 × 44 mm L section with 8 mm walls is open for editing. This guide teaches sketch selection only.",
      "chapter": "Prepared bracket"
    },
    {
      "id": "bracket_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / prepared 32 by 44 section",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "id": "bracket_snap",
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "bracket_line_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_0": {
          "$select": {
            "from": {
              "$ref": "bracket_line_0",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Limo CAD native command script version 1",
  "description": "Readable shared-interface commands interpreted by Rust. A file is either a version-1 script or a collection fragment. Includes are relative to the file that declares them. Modeling arguments use the existing operation schemas; result references are resolved at runtime.",
  "oneOf": [
    {
      "$ref": "#/$defs/script_document"
    },
    {
      "$ref": "#/$defs/collection_document"
    }
  ],
  "$defs": {
    "script_document": {
      "description": "Version-1 command script.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "steps"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "starting_state": {
          "const": "empty"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "garden-bench"
          ],
          "description": "Optional native end gate for the reference model."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Evaluated after construction; operation errors still stop at their point of occurrence."
        },
        "exports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "views": {
          "type": "array",
          "description": "Named view configurations stored in the project when the script runs. Each view recalls a camera, the bodies that stay visible, and optional display offsets so an exploded review does not need a second script.",
          "items": {
            "$ref": "#/$defs/named_view"
          }
        },
        "includes": {
          "type": "array",
          "description": "Relative collection fragments composed before steps/checks. Expanded by the host loader; the Rust parser rejects unresolved includes.",
          "items": {
            "$ref": "#/$defs/include_entry"
          }
        }
      }
    },
    "value": {
      "description": "Literal JSON data or a runtime result expression. The Rust interpreter validates nested expressions and their result types.",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "object",
          "additionalProperties": {},
          "not": {
            "anyOf": [
              {
                "required": [
                  "$ref"
                ]
              },
              {
                "required": [
                  "$select"
                ]
              },
              {
                "required": [
                  "$count"
                ]
              },
              {
                "required": [
                  "$project"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$count"
          ],
          "properties": {
            "$count": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$select"
          ],
          "properties": {
            "$select": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from"
              ],
              "properties": {
                "from": {},
                "path": {
                  "type": "string"
                },
                "where": {
                  "$ref": "#/$defs/predicate"
                },
                "take": {
                  "enum": [
                    "one",
                    "first",
                    "last",
                    "all"
                  ]
                },
                "pointer": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$project"
          ],
          "properties": {
            "$project": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "point",
                "basis"
              ],
              "properties": {
                "point": {},
                "basis": {}
              }
            }
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "description": "JSON-pointer field predicates, $and/$or arrays, or $every over an array path.",
      "additionalProperties": {},
      "properties": {
        "$and": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "$or": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "$every": {
          "type": "object",
          "required": [
            "path",
            "where"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "where": {
              "type": "object"
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group",
            "operation",
            "arguments"
          ],
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        "bind": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Name a JSON-pointer projection of the same call result."
        },
        "expect": {
          "$ref": "#/$defs/predicate"
        },
        "let": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "assert": {
          "$ref": "#/$defs/value"
        },
        "equals": {
          "$ref": "#/$defs/value"
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "chapter": {
          "type": "string",
          "maxLength": 200
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "orbit_degrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "With view current, rotate around the current target/up axis at fixed radius and elevation; optional framing happens first."
        },
        "view": {
          "enum": [
            "current",
            "isometric",
            "front",
            "back",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "fit": {
          "type": "boolean"
        },
        "body_id": {
          "$ref": "#/$defs/focal_id"
        },
        "component_id": {
          "$ref": "#/$defs/focal_id"
        },
        "target": {
          "const": "active_sketch"
        }
      },
      "oneOf": [
        {
          "required": [
            "call"
          ]
        },
        {
          "required": [
            "let"
          ]
        },
        {
          "required": [
            "assert"
          ]
        },
        {
          "required": [
            "note"
          ]
        },
        {
          "required": [
            "view"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "orbit_degrees"
            ]
          },
          "then": {
            "required": [
              "view"
            ],
            "properties": {
              "view": {
                "const": "current"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "assert"
            ]
          },
          "then": {
            "required": [
              "equals"
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "body_id",
                  "component_id"
                ]
              },
              {
                "required": [
                  "body_id",
                  "target"
                ]
              },
              {
                "required": [
                  "component_id",
                  "target"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "note"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "note",
                "chapter",
                "duration_ms"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "view"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "view",
                "fit",
                "target",
                "body_id",
                "component_id",
                "duration_ms",
                "orbit_degrees"
              ]
            }
          }
        }
      ]
    },
    "named_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "camera", "visible_body_ids"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "target", "up"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3" },
            "target": { "$ref": "#/$defs/vec3" },
            "up": { "$ref": "#/$defs/vec3" }
          }
        },
        "visible_body_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/focal_id" }
        },
        "part_offsets": {
          "type": "array",
          "description": "Display-only translations in millimeters. They do not edit solid geometry.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body_id", "translation"],
            "properties": {
              "body_id": { "$ref": "#/$defs/focal_id" },
              "translation": { "$ref": "#/$defs/vec3" }
            }
          }
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "focal_id": {
      "description": "A nonnegative body/component ID or an expression resolving to one.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "$ref"
                  ]
                },
                {
                  "required": [
                    "$select"
                  ]
                },
                {
                  "required": [
                    "$count"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "include_entry": {
      "description": "Path to a .collection.jsonc or .limo.jsonc fragment, relative to the file that declares the include.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "collection_document": {
      "description": "Fragment composed via includes. Not a full version-1 script.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "includes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/include_entry"
          }
        },
        "$schema": {
          "type": "string"
        }
      }
    }
  }
}

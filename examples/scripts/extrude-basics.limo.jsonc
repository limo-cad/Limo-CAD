{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Bracket foundations: sketch, extrude and cut",
  "starting_state": "empty",
  "steps": [
    {
      "id": "empty_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "chapter": "Constrain the section",
      "note": "Draw one closed six-edge L. Horizontal and vertical relations establish square corners; four driving lengths set a 40 × 30 mm envelope and 5 mm walls.",
      "duration_ms": 1000
    },
    {
      "id": "bracket_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / dimensioned L section",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "id": "bracket_line_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 40,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_0": {
          "$select": {
            "from": {
              "$ref": "bracket_line_0",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 40,
            "y": 0
          },
          "to_raw": {
            "x": 40,
            "y": 5
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_1": {
          "$select": {
            "from": {
              "$ref": "bracket_line_1",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_2",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 40,
            "y": 5
          },
          "to_raw": {
            "x": 5,
            "y": 5
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_2": {
          "$select": {
            "from": {
              "$ref": "bracket_line_2",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_3",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 5,
            "y": 5
          },
          "to_raw": {
            "x": 5,
            "y": 30
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_3": {
          "$select": {
            "from": {
              "$ref": "bracket_line_3",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_4",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 5,
            "y": 30
          },
          "to_raw": {
            "x": 0,
            "y": 30
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_4": {
          "$select": {
            "from": {
              "$ref": "bracket_line_4",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 30
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_5": {
          "$select": {
            "from": {
              "$ref": "bracket_line_5",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "bracket_line_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/id": {
                  "$ref": "bracket_edge_0"
                }
              },
              "take": "one",
              "pointer": "/start_id"
            }
          }
        }
      }
    },
    {
      "id": "bracket_square",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraints",
        "arguments": {
          "constraints": [
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_0"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_1"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_2"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_3"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_4"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_5"
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "bracket_dimension_0",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_0"
            }
          ],
          "text_pos": {
            "x": 20,
            "y": -6
          },
          "value_text": "40"
        }
      }
    },
    {
      "id": "bracket_dimension_1",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_1"
            }
          ],
          "text_pos": {
            "x": 47,
            "y": 2.5
          },
          "value_text": "5"
        }
      }
    },
    {
      "id": "bracket_dimension_4",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_4"
            }
          ],
          "text_pos": {
            "x": 2.5,
            "y": 37
          },
          "value_text": "5"
        }
      }
    },
    {
      "id": "bracket_dimension_5",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_5"
            }
          ],
          "text_pos": {
            "x": -7,
            "y": 15
          },
          "value_text": "30"
        }
      }
    },
    {
      "chapter": "Extrude the finished L profile",
      "note": "The Sketch example ends here. Extrude starts from this completed profile.",
      "duration_ms": 1200
    },
    {
      "chapter": "Give the bracket width",
      "note": "Extrude the fully located section by 20 mm. The section dimensions and extrusion width remain independent editable parameters.",
      "duration_ms": 1000
    },
    {
      "view": "current",
      "fit": true,
      "target": "active_sketch",
      "duration_ms": 250
    },
    {
      "id": "bracket_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "finished_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finished",
        "arguments": {}
      }
    },
    {
      "id": "bracket_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / dimensioned L section",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 5
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "bracket_feature": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "depth_12",
      "call": {
        "group": "solid/build",
        "operation": "solid_edit_extrude",
        "arguments": {
          "feature_id": {
            "$ref": "bracket_feature"
          },
          "extrude": {
            "sketch_name": "Bracket / dimensioned L section",
            "profile_indices": [
              0
            ],
            "operation": "new_body",
            "extent": {
              "type": "distance",
              "distance": 12
            },
            "taper_angle_deg": 0,
            "flip": true,
            "target_body_ids": []
          }
        }
      }
    },
    {
      "id": "depth_20",
      "call": {
        "group": "solid/build",
        "operation": "solid_edit_extrude",
        "arguments": {
          "feature_id": {
            "$ref": "bracket_feature"
          },
          "extrude": {
            "sketch_name": "Bracket / dimensioned L section",
            "profile_indices": [
              0
            ],
            "operation": "new_body",
            "extent": {
              "type": "distance",
              "distance": 20
            },
            "taper_angle_deg": 0,
            "flip": true,
            "target_body_ids": []
          }
        }
      }
    },
    {
      "let": {
        "bracket_body": {
          "$select": {
            "from": {
              "$ref": "depth_20"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "bracket_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "body_id": {
        "$ref": "bracket_body",
        "pointer": "/id"
      },
      "duration_ms": 350
    },
    {
      "let": {
        "bracket_finished_body": {
          "$ref": "bracket_body"
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "duration_ms": 400
    },
    {
      "chapter": "Cut the mounting hole",
      "note": "A second sketch is setup for Cut, not another Sketch demonstration. Use the upright face and a 6 mm circle, then Extrude with Cut and Through all.",
      "duration_ms": 1400
    },
    {
      "let": {
        "hole_face": {
          "$select": {
            "from": {
              "$ref": "bracket_body"
            },
            "path": "/faces",
            "where": {
              "/plane/normal/0": 1,
              "/plane/origin/0": 5
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "hole_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / mounting hole",
          "plane": {
            "type": "planar_face",
            "face_id": {
              "$ref": "hole_face",
              "pointer": "/id"
            }
          },
          "face_origin": "global_origin_projection"
        }
      }
    },
    {
      "id": "hole_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_circle_locked",
        "arguments": {
          "mode": "center_diameter",
          "anchor": {
            "$project": {
              "point": [
                5,
                10,
                20
              ],
              "basis": {
                "$ref": "hole_begin",
                "pointer": "/basis"
              }
            }
          },
          "edge_hint": {
            "$project": {
              "point": [
                5,
                13,
                20
              ],
              "basis": {
                "$ref": "hole_begin",
                "pointer": "/basis"
              }
            }
          },
          "diameter_mm": 6,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "hole_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "cut_partial",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / mounting hole",
          "profile_indices": [
            0
          ],
          "operation": "cut",
          "extent": {
            "type": "distance",
            "distance": 2
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": [
            {
              "$ref": "bracket_body",
              "pointer": "/id"
            }
          ]
        }
      }
    },
    {
      "let": {
        "cut_feature": {
          "$select": {
            "from": {
              "$ref": "cut_partial"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "cut_through",
      "call": {
        "group": "solid/build",
        "operation": "solid_edit_extrude",
        "arguments": {
          "feature_id": {
            "$ref": "cut_feature"
          },
          "extrude": {
            "sketch_name": "Bracket / mounting hole",
            "profile_indices": [
              0
            ],
            "operation": "cut",
            "extent": {
              "type": "through_all"
            },
            "taper_angle_deg": 0,
            "flip": true,
            "target_body_ids": [
              {
                "$ref": "bracket_body",
                "pointer": "/id"
              }
            ]
          }
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "duration_ms": 400
    },
    {
      "let": {
        "sketch_frames": [
          {
            "caption": "sketch.plane",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "plane",
            "duration_ms": 1400,
            "profile": {
              "$ref": "bracket_begin"
            }
          },
          {
            "caption": "sketch.outline",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "profile",
            "duration_ms": 1400,
            "profile": {
              "$ref": "bracket_line_2",
              "pointer": "/sketch"
            }
          },
          {
            "caption": "sketch.close",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "profile",
            "duration_ms": 1400,
            "profile": {
              "$ref": "bracket_line_5",
              "pointer": "/sketch"
            }
          },
          {
            "caption": "sketch.dimension",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "dimension",
            "duration_ms": 1400,
            "profile": {
              "$ref": "bracket_dimension_5",
              "pointer": "/sketch"
            }
          },
          {
            "caption": "sketch.finish",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "apply",
            "duration_ms": 1400,
            "profile": {
              "$ref": "finished_profile",
              "pointer": "/0"
            }
          }
        ],
        "extrude_frames": [
          {
            "caption": "extrude.profile",
            "scene": {
              "$ref": "empty_scene"
            },
            "cue": "profile",
            "duration_ms": 1400,
            "profile": {
              "$ref": "finished_profile",
              "pointer": "/0"
            }
          },
          {
            "caption": "extrude.start",
            "scene": {
              "$ref": "bracket_build",
              "pointer": "/scene"
            },
            "cue": "extrude",
            "duration_ms": 500
          },
          {
            "caption": "extrude.distance",
            "scene": {
              "$ref": "depth_12",
              "pointer": "/scene"
            },
            "cue": "depth",
            "duration_ms": 500
          },
          {
            "caption": "extrude.width",
            "scene": {
              "$ref": "depth_20",
              "pointer": "/scene"
            },
            "cue": "depth",
            "duration_ms": 1400
          },
          {
            "caption": "extrude.apply",
            "scene": {
              "$ref": "depth_20",
              "pointer": "/scene"
            },
            "cue": "apply",
            "duration_ms": 1400
          }
        ],
        "cut_frames": [
          {
            "caption": "cut.profile",
            "scene": {
              "$ref": "depth_20",
              "pointer": "/scene"
            },
            "cue": "profile",
            "duration_ms": 1400,
            "profile": {
              "$ref": "hole_profile",
              "pointer": "/sketch"
            }
          },
          {
            "caption": "cut.operation",
            "scene": {
              "$ref": "cut_partial",
              "pointer": "/scene"
            },
            "cue": "cut",
            "duration_ms": 1400
          },
          {
            "caption": "cut.through",
            "scene": {
              "$ref": "cut_through",
              "pointer": "/scene"
            },
            "cue": "depth",

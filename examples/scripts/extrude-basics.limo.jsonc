{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Bracket foundations: sketch, extrude, fillet and cut",
  "starting_state": "empty",
  "steps": [
    {
      "id": "empty_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "chapter": "Constrain the section",
      "note": "Draw one closed six-edge L. Horizontal and vertical relations establish square corners; four driving lengths set a 30 × 40 mm envelope and 6 mm walls.",
      "duration_ms": 1000
    },
    {
      "id": "bracket_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / dimensioned L section",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "id": "bracket_line_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_0": {
          "$select": {
            "from": {
              "$ref": "bracket_line_0",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_1": {
          "$select": {
            "from": {
              "$ref": "bracket_line_1",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_2",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_2": {
          "$select": {
            "from": {
              "$ref": "bracket_line_2",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_3",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_3": {
          "$select": {
            "from": {
              "$ref": "bracket_line_3",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_4",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_4": {
          "$select": {
            "from": {
              "$ref": "bracket_line_4",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_5": {
          "$select": {
            "from": {
              "$ref": "bracket_line_5",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "bracket_line_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/id": {
                  "$ref": "bracket_edge_0"
                }
              },
              "take": "one",
              "pointer": "/start_id"
            }
          }
        }
      }
    },
    {
      "id": "bracket_square",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraints",
        "arguments": {
          "constraints": [
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_0"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_1"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_2"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_3"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_4"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_5"
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "bracket_dimension_0",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_0"
            }
          ],
          "text_pos": {
            "x": 16,
            "y": -7
          },
          "value_text": "32"
        }
      }
    },
    {
      "id": "bracket_dimension_1",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_1"
            }
          ],
          "text_pos": {
            "x": 39,
            "y": 4
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_4",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_4"
            }
          ],
          "text_pos": {
            "x": 4,
            "y": 51
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_5",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_5"
            }
          ],
          "text_pos": {
            "x": -7,
            "y": 22
          },
          "value_text": "44"
        }
      }
    },
    {
      "chapter": "Extrude the finished L profile",
      "note": "The Sketch example ends here. Extrude starts from this completed profile.",
      "duration_ms": 1200
    },
    {
      "chapter": "Give the bracket width",
      "note": "Extrude the fully located section by 40 mm. The section dimensions and extrusion width remain independent editable parameters.",
      "duration_ms": 1000
    },
    {
      "view": "current",
      "fit": true,
      "target": "active_sketch",
      "duration_ms": 250
    },
    {
      "id": "bracket_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "finished_profile",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finished",
        "arguments": {}
      }
    },
    {
      "id": "bracket_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / dimensioned L section",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 6
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "bracket_feature": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "depth_24",
      "call": {
        "group": "solid/build",
        "operation": "solid_edit_extrude",
        "arguments": {
          "feature_id": {
            "$ref": "bracket_feature"
          },
          "extrude": {
            "sketch_name": "Bracket / dimensioned L section",
            "profile_indices": [
              0
            ],
            "operation": "new_body",
            "extent": {
              "type": "distance",
              "distance": 24
            },
            "taper_angle_deg": 0,
            "flip": true,
            "target_body_ids": []
          }
        }
      }
    },
    {
      "id": "depth_40",
      "call": {
        "group": "solid/build",
        "operation": "solid_edit_extrude",
        "arguments": {
          "feature_id": {
            "$ref": "bracket_feature"
          },
          "extrude": {
            "sketch_name": "Bracket / dimensioned L section",
            "profile_indices": [
              0
            ],
            "operation": "new_body",
            "extent": {
              "type": "distance",
              "distance": 40
            },
            "taper_angle_deg": 0,
            "flip": true,
            "target_body_ids": []
          }
        }
      }
    },
    {
      "let": {
        "bracket_body": {
          "$select": {
            "from": {
              "$ref": "depth_40"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "bracket_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "body_id": {
        "$ref": "bracket_body",
        "pointer": "/id"
      },
      "duration_ms": 350
    },
    {
      "let": {
        "bracket_finished_body": {
          "$ref": "bracket_body"
        }
      }
    },
    {
      "view": "isometric",
      "fit": true,
      "duration_ms": 400
    },
    {
      "chapter": "Cut the mounting hole",
      "note": "The rounded corners, two base mounting holes and upright circle are prepared before Cut. This example only teaches subtracting the large upright hole.",
      "duration_ms": 1400
    },
    {
      "chapter": "Prepare the shared bracket for Cut",
      "note": "Supporting setup, outside the focused operation clips: round the bend and corners, cut two base holes and assign satin aluminum."
    },
    {
      "let": {
        "bend_edges": {
          "$select": {
            "from": {
              "$ref": "bracket_finished_body"
            },
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$every": {
                "path": "/points",
                "where": {
                  "/x": 8,
                  "/z": 8
                }
              }
            },
            "take": "all",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "bend_edges"
        }
      },
      "equals": 1
    },
    {
      "id": "bend",
      "call": {
        "group": "solid/refine",
        "operation": "solid_fillet",
        "arguments": {
          "body_id": {
            "$ref": "bracket_body",
            "pointer": "/id"
          },
          "edge_ids": {
            "$ref": "bend_edges"
          },
          "radius": 4,
          "tangent_chain": false
        }
      }
    },
    {
      "let": {
        "bend_body": {
          "$select": {
            "from": {
              "$ref": "bend"
            },
            "path": "/scene/bodies",
            "where": {},
            "take": "one"
          }
        }
      }
    },
    {
      "let": {
        "corners_edges": {
          "$select": {
            "from": {
              "$ref": "bend_body"
            },
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$or": [
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/y": 0,
                      "/z": 44
                    }
                  }
                },
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/y": 40,
                      "/z": 44
                    }
                  }
                },
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/x": 32,
                      "/y": 0
                    }
                  }
                },
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/x": 32,
                      "/y": 40
                    }
                  }
                }
              ]
            },
            "take": "all",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "corners_edges"
        }
      },
      "equals": 4
    },
    {
      "id": "corners",
      "call": {
        "group": "solid/refine",
        "operation": "solid_fillet",
        "arguments": {
          "body_id": {
            "$ref": "bracket_body",
            "pointer": "/id"
          },
          "edge_ids": {
            "$ref": "corners_edges"
          },
          "radius": 3,
          "tangent_chain": false
        }
      }
    },
    {
      "let": {
        "corners_body": {
          "$select": {
            "from": {
              "$ref": "corners"
            },
            "path": "/scene/bodies",
            "where": {},
            "take": "one"
          }
        }
      }
    },
    {
      "let": {
        "edge_break_edges": {
          "$select": {
            "from": {
              "$ref": "corners_body"
            },
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$or": [
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/y": 0
                    }
                  }
                },
                {
                  "$every": {
                    "path": "/points",
                    "where": {
                      "/y": 40
                    }
                  }
                }
              ]
            },
            "take": "all",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "edge_break_edges"
        }
      },
      "equals": 10
    },
    {
      "id": "edge_break",
      "call": {
        "group": "solid/refine",
        "operation": "solid_fillet",
        "arguments": {
          "body_id": {
            "$ref": "bracket_body",
            "pointer": "/id"
          },
          "edge_ids": {
            "$ref": "edge_break_edges"
          },
          "radius": 0.6,
          "tangent_chain": false
        }
      }
    },
    {
      "let": {
        "edge_break_body": {
          "$select": {
            "from": {
              "$ref": "edge_break"
            },
            "path": "/scene/bodies",
            "where": {},
            "take": "one"
          }
        }
      }
    },
    {
      "let": {
        "base_face": {
          "$select": {
            "from": {
              "$ref": "edge_break_body"
            },
            "path": "/faces",
            "where": {
              "/plane/normal/2": 1,
              "/plane/origin/2": 8
            },
            "take": "one"
          }
        }
      }
    },
    {
      "id": "base_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / base mounting holes",
          "plane": {
            "type": "planar_face",
            "face_id": {
              "$ref": "base_face",
              "pointer": "/id"
            }
          },
          "face_origin": "global_origin_projection"
        }
      }
    },
    {
      "id": "base_circle_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_circle_locked",
        "arguments": {
          "mode": "center_diameter",
          "anchor": {
            "$project": {
              "point": [
                24,
                8,
                8
              ],
              "basis": {
                "$ref": "base_begin",
                "pointer": "/basis"
              }
            }
          },
          "edge_hint": {
            "$project": {
              "point": [
                27.5,
                8,
                8
              ],
              "basis": {
                "$ref": "base_begin",
                "pointer": "/basis"
              }
            }
          },
          "diameter_mm": 7,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "base_circle_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_circle_locked",
        "arguments": {
          "mode": "center_diameter",
          "anchor": {
            "$project": {
              "point": [

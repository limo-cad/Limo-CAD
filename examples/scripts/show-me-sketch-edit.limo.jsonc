{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Bracket sketch guides: transform, trim and dress layout geometry",
  "starting_state": "empty",
  "steps": [
    {
      "id": "empty_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "chapter": "sketch_move_copy",
      "note": "Independent bracket layout study on the XZ plane; all coordinates are sketch millimeters. The six-edge 32 x 44 mm L with 8 mm walls is shared context. Extra curves are layout examples, not a fabrication-ready profile.",
      "duration_ms": 0
    },
    {
      "id": "sketch_move_copy_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / move_copy",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "id": "sketch_move_copy_snap",
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "sketch_move_copy_context_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_move_copy_context_1",
      "call": {
        "group": "sketch/draw",

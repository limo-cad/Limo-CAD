          "to_raw": {
            "x": 0,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_move_copy_context_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {

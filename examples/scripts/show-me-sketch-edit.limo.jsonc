          "ctrl_held": true
        }
      }
    },
    {
      "id": "sketch_move_copy_context_fixed",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_toggle_fix",
        "arguments": {
          "entity_ids": {
            "$select": {
              "from": {
                "$ref": "sketch_move_copy_context_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point"
              },
              "take": "all",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "move_seed",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_circle",
        "arguments": {
          "mode": "center_diameter",
          "p1": {
            "x": 16,
            "y": 16
          },
          "p2": {
            "x": 18,
            "y": 16
          },
          "ctrl_held": true
        }
      }
    },
    {
      "id": "move_result",
      "call": {
        "group": "sketch/edit",
        "operation": "sketch_move_copy",
        "arguments": {
          "entity_ids": [
            {
              "$select": {
                "from": {
                  "$ref": "move_seed",
                  "pointer": "/sketch"
                },
                "path": "/entities",
                "where": {
                  "/kind": "circle"
                },
                "take": "last",
                "pointer": "/id"
              }
            }
          ],
          "dx": 8,
          "dy": 0,
          "copy": false
        }
      }
    },
    {

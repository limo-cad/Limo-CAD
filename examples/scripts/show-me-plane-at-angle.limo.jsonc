{
  "$schema": "./limo-cad-script.schema.json",
  "version": 1,
  "name": "Tilt a plane about a bracket edge",
  "starting_state": "empty",
  "steps": [
    {
      "chapter": "Prepared inputs",
      "note": "The prepared bracket is 32 x 40 x 44 mm with 8 mm walls. Its sketch and extrusion already exist; this guide teaches only the named operation.",
      "duration_ms": 1000
    },
    {
      "id": "empty_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      }
    },
    {
      "id": "bracket_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "Bracket / prepared 32 by 44 section",
          "plane": {
            "type": "origin_plane",
            "plane": "xz"
          }
        }
      }
    },
    {
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "bracket_line_0",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_0": {
          "$select": {
            "from": {
              "$ref": "bracket_line_0",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_1",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 0
          },
          "to_raw": {
            "x": 32,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_1": {
          "$select": {
            "from": {
              "$ref": "bracket_line_1",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_2",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 32,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 8
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_2": {
          "$select": {
            "from": {
              "$ref": "bracket_line_2",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_3",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 8
          },
          "to_raw": {
            "x": 8,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_3": {
          "$select": {
            "from": {
              "$ref": "bracket_line_3",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_4",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 8,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 44
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_4": {
          "$select": {
            "from": {
              "$ref": "bracket_line_4",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_line_5",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_line",
        "arguments": {
          "from": {
            "x": 0,
            "y": 44
          },
          "to_raw": {
            "x": 0,
            "y": 0
          },
          "ctrl_held": true
        }
      }
    },
    {
      "let": {
        "bracket_edge_5": {
          "$select": {
            "from": {
              "$ref": "bracket_line_5",
              "pointer": "/sketch"
            },
            "path": "/entities",
            "where": {
              "/kind": "line"
            },
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "id": "bracket_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "bracket_line_5",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/id": {
                  "$ref": "bracket_edge_0"
                }
              },
              "take": "one",
              "pointer": "/start_id"
            }
          }
        }
      }
    },
    {
      "id": "bracket_square",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraints",
        "arguments": {
          "constraints": [
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_0"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_1"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_2"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_3"
              }
            },
            {
              "type": "horizontal",
              "entity": {
                "$ref": "bracket_edge_4"
              }
            },
            {
              "type": "vertical",
              "entity": {
                "$ref": "bracket_edge_5"
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_1"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_2"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_3"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_4"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            },
            {
              "type": "coincident",
              "a": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_5"
                    }
                  },
                  "take": "one",
                  "pointer": "/end_id"
                }
              },
              "b": {
                "$select": {
                  "from": {
                    "$ref": "bracket_line_5",
                    "pointer": "/sketch"
                  },
                  "path": "/entities",
                  "where": {
                    "/id": {
                      "$ref": "bracket_edge_0"
                    }
                  },
                  "take": "one",
                  "pointer": "/start_id"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "bracket_dimension_0",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_0"
            }
          ],
          "text_pos": {
            "x": 20,
            "y": -6
          },
          "value_text": "32"
        }
      }
    },
    {
      "id": "bracket_dimension_1",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_1"
            }
          ],
          "text_pos": {
            "x": 47,
            "y": 2.5
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_4",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_4"
            }
          ],
          "text_pos": {
            "x": 2.5,
            "y": 37
          },
          "value_text": "8"
        }
      }
    },
    {
      "id": "bracket_dimension_5",
      "call": {
        "group": "sketch/dimension",
        "operation": "sketch_add_dimension",
        "arguments": {
          "entities": [
            {
              "$ref": "bracket_edge_5"
            }
          ],
          "text_pos": {
            "x": -7,
            "y": 15
          },
          "value_text": "44"
        }
      }
    },
    {
      "id": "bracket_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "id": "bracket_build",
      "call": {
        "group": "solid/build",
        "operation": "solid_extrude",
        "arguments": {
          "sketch_name": "Bracket / prepared 32 by 44 section",
          "profile_indices": [
            0
          ],
          "operation": "new_body",
          "extent": {
            "type": "distance",
            "distance": 40
          },
          "taper_angle_deg": 0,
          "flip": true,
          "target_body_ids": []
        }
      }
    },
    {
      "let": {
        "bracket_feature": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/document/features",
            "take": "last",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "let": {
        "bracket_body": {
          "$select": {
            "from": {
              "$ref": "bracket_build"
            },
            "path": "/scene/bodies",
            "where": {
              "/feature_id": {
                "$ref": "bracket_feature"
              }
            },
            "take": "one"
          }
        }
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "bracket_build",
          "pointer": "/scene/bodies"
        }
      },
      "equals": 1
    },
    {
      "let": {
        "hinge_edge": {
          "$select": {
            "from": {
              "$ref": "bracket_body"
            },
            "path": "/edges",
            "where": {
              "/refinable": true,
              "$every": {
                "path": "/points",
                "where": {
                  "/y": 0,
                  "/z": 0
                }
              }
            },
            "take": "all",
            "pointer": "/id"
          }
        }
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "hinge_edge"
        }
      },
      "equals": 1
    },
    {
      "id": "xy_reference_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "xy_reference",
          "plane": {
            "type": "origin_plane",
            "plane": "xy"
          }
        }
      }
    },
    {
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "xy_reference_rectangle",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {
            "x": 0,
            "y": 0
          },
          "corner_hint": {
            "x": 32,
            "y": 24
          },
          "width_mm": 32,
          "height_mm": 24,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "xy_reference_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "xy_reference_rectangle",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point",
                "/position/x": 0,
                "/position/y": 0
              },
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "xy_reference_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    },
    {
      "chapter": "Plane at angle",
      "note": "Select XY and the straight lower front edge lying on XY. Rotate a construction plane 30 degrees around that stable edge.",
      "duration_ms": 1000
    },
    {
      "id": "angled",
      "call": {
        "group": "solid/reference",
        "operation": "construction_plane_at_angle",
        "arguments": {
          "name": "Bracket / 30 degree reference",
          "reference": {
            "type": "origin_plane",
            "plane": "xy"
          },
          "body_id": {
            "$ref": "bracket_body",
            "pointer": "/id"
          },
          "edge_id": {
            "$ref": "hinge_edge",
            "pointer": "/0"
          },
          "angle_deg": 30
        }
      }
    },
    {
      "id": "angle_reference_begin",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_begin",
        "arguments": {
          "name": "angle_reference",
          "plane": {
            "type": "datum_plane",
            "datum_id": {
              "$ref": "angled",
              "pointer": "/planes/0/datum_id"
            }
          }
        }
      }
    },
    {
      "call": {
        "group": "sketch/selection",
        "operation": "sketch_set_grid_snap",
        "arguments": {
          "enabled": false
        }
      }
    },
    {
      "id": "angle_reference_rectangle",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_add_rectangle_locked",
        "arguments": {
          "mode": "two_point",
          "anchor": {
            "x": 0,
            "y": 0
          },
          "corner_hint": {
            "x": 32,
            "y": 24
          },
          "width_mm": 32,
          "height_mm": 24,
          "ctrl_held": true
        }
      }
    },
    {
      "id": "angle_reference_locate",
      "call": {
        "group": "sketch/constrain",
        "operation": "sketch_add_constraint",
        "arguments": {
          "type": "fix",
          "entity": {
            "$select": {
              "from": {
                "$ref": "angle_reference_rectangle",
                "pointer": "/sketch"
              },
              "path": "/entities",
              "where": {
                "/kind": "point",
                "/position/x": 0,
                "/position/y": 0
              },
              "take": "one",
              "pointer": "/id"
            }
          }
        }
      }
    },
    {
      "id": "angle_reference_finish",
      "call": {
        "group": "sketch/draw",
        "operation": "sketch_finish",
        "arguments": {}
      }
    }
  ],
  "checks": [
    {
      "id": "definitions",
      "call": {
        "group": "solid/reference",
        "operation": "construction_plane_definitions",
        "arguments": {}
      }
    },
    {
      "assert": {
        "$count": {
          "$ref": "definitions"
        }
      },
      "equals": 1
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/source/type"
      },
      "equals": "at_angle"
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/source/angle_deg"
      },
      "equals": 30
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/source/reference"
      },
      "equals": {
        "type": "origin_plane",
        "plane": "xy"
      }
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/source/body_id"
      },
      "equals": {
        "$ref": "bracket_body",
        "pointer": "/id"
      }
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/source/edge_id"
      },
      "equals": {
        "$ref": "hinge_edge",
        "pointer": "/0"
      }
    },
    {
      "assert": {
        "$ref": "definitions",
        "pointer": "/0/basis/normal/2"
      },
      "equals": 0.8660254037844387
    },
    {
      "id": "final_scene",
      "call": {
        "group": "solid/check",
        "operation": "solid_scene",
        "arguments": {}
      },
      "expect": {
        "/errors": []
      }
    },
    {
      "assert": {
        "$ref": "final_scene",
        "pointer": "/bodies"
      },
      "equals": {
        "$ref": "bracket_build",
        "pointer": "/scene/bodies"
      }
    }
  ],
  "exports": {
    "lessons": {
      "plane_at_angle": [
        {
          "caption": "plane_at_angle.inputs",
          "scene": {
            "$ref": "bracket_build",
            "pointer": "/scene"
          },
          "cue": "edges",
          "duration_ms": 1400,
          "finish": "satin_aluminum",
          "edges": {
            "$ref": "hinge_edge"
          }
        },
        {
          "caption": "plane_at_angle.preview",
          "scene": {
            "$ref": "bracket_build",
            "pointer": "/scene"
          },
          "cue": "plane",
          "duration_ms": 1400,
          "finish": "satin_aluminum",
          "profile": {
            "$ref": "xy_reference_locate",
            "pointer": "/sketch"
          }
        },
        {
          "caption": "plane_at_angle.parameter",
          "scene": {
            "$ref": "bracket_build",
            "pointer": "/scene"
          },
          "cue": "dimension",
          "duration_ms": 1400,
          "finish": "satin_aluminum",
          "profile": {
            "$ref": "angle_reference_locate",
            "pointer": "/sketch"
          }
        },
        {
          "caption": "plane_at_angle.apply",
          "scene": {
            "$ref": "bracket_build",
            "pointer": "/scene"
          },
          "cue": "apply",
          "duration_ms": 1400,
          "finish": "satin_aluminum",
          "profile": {
            "$ref": "angle_reference_locate",
            "pointer": "/sketch"
          }
        }
      ]
    },
    "preview_frames": [
      {
        "caption": "plane_at_angle.inputs",
        "scene": {
          "$ref": "bracket_build",
          "pointer": "/scene"
        },
        "cue": "edges",
        "duration_ms": 1400,
        "finish": "satin_aluminum",
        "edges": {
          "$ref": "hinge_edge"
        }
